{
  "name": "dfns-mcp",
  "version": "1.0.0",
  "description": "MCP server for DFNS documentation and SDK reference",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "dfns-mcp": "./src/index.ts"
  },
