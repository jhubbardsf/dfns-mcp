{
  "mcpServers": {
    "web-search-prime": {
      "type": "http",
      "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
      "headers": {
        "Authorization": "Bearer ${Z_AI_API_KEY}"
      }
    },
    "zai-mcp-server": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@z_ai/mcp-server"
      ],
      "env": {
        "Z_AI_MODE": "ZAI"
      }
    },
    "magnitude": {
      "command": "bun",
      "args": [
        "/Users/josh/Engineering/magnitude/packages/magnitude-mcp/src/index.ts"
      ],
      "env": {
        "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY_SKYVERN}",
        "MAGNITUDE_MCP_VIEWPORT_WIDTH": "1024",
        "MAGNITUDE_MCP_VIEWPORT_HEIGHT": "728"
      },
      "autoStart": true,
      "timeoutMs": 30000
    },
    "dfns-docs": {
      "command": "bun",
      "args": ["run", "/Users/josh/Engineering/dfns-mcp/src/index.ts"]
    },
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"]
    }  
  }
}
