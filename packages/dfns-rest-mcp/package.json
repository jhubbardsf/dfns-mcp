{
  "name": "dfns-rest-mcp",
  "version": "1.0.0",
  "description": "MCP server for DFNS REST API operations - wallet management, transaction signing, and organization operations",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "dfns-rest-mcp": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "inspect": "bunx @anthropics/inspector bun run src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dfns/sdk": "^0.7.0",
    "@dfns/sdk-keysigner": "^0.7.0",
    "@modelcontextprotocol/sdk": "^1.23.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
